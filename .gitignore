# Keep config templates, ignore runtime data and secrets
**/config/
**/data/
**/.env
!**/.env.example
**/docker.env

# Nginx Proxy Manager
npm/letsencrypt/

# Databases
postgres/postgres-data/

# stacks runtime directories (non-config, non-data)
stacks/**/downloads/
stacks/**/uploads/
stacks/**/processed/
stacks/**/movies/
stacks/**/tv/

# Generic ignores
*.log
*.sqlite
tmp/