# Application
APP_URL=https://invoices.example.com
APP_KEY=
APP_ENV=production
APP_DEBUG=false
REQUIRE_HTTPS=false
TRUSTED_PROXIES='*'
PHANTOMJS_PDF_GENERATION=false
PDF_GENERATOR=snappdf

# Cache / Queue / Session (all backed by Redis)
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Database — uses the shared mariadb container on the proxy network
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=invoiceninja
DB_USERNAME=invoiceninja
DB_PASSWORD=change_me_secure_password

# Initial admin account (remove after first successful login)
IN_USER_EMAIL=admin@example.com
IN_PASSWORD=changeme!

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=invoices@example.com
MAIL_FROM_NAME='Invoice Ninja'

# Docker
IS_DOCKER=true
FILESYSTEM_DISK=debian_docker
SCOUT_DRIVER=null
