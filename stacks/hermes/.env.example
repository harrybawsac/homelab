# User/Group IDs (run `id -u` and `id -g` to find yours)
PUID=1000
PGID=1000

# API Server settings (OpenAI-compatible)
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY=generate_with_openssl_rand_hex_32
API_SERVER_CORS_ORIGINS=*

# Dashboard authentication (required for non-loopback bind)
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change_me_secure_password
# Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=generate_with_openssl_rand_hex_32

# LAN IP for port binding (leave blank for 0.0.0.0)
# LAN_IP=192.168.1.100

# Resource limits (recommended: 4G memory, 2 CPUs for browser tools)
HERMES_MEMORY_LIMIT=4G
HERMES_CPU_LIMIT=2.0
